        <mxCell id="VMS7KO3oDyNADhuaiB5c-22" edge="1" parent="1" source="VMS7KO3oDyNADhuaiB5c-14" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#DC2626;fontStyle=1;fontSize=10;fontColor=#DC2626;exitX=0.5;exitY=0;entryX=0.5;entryY=1;curved=1;" target="VMS7KO3oDyNADhuaiB5c-4" value="Next Sprint Cycle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VMS7KO3oDyNADhuaiB5c-23" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#0D1B2A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="WHY AGILE / SCRUM WAS CHOSEN FOR MitigatePlus" vertex="1">
          <mxGeometry height="210" width="880" x="439.20001220703125" y="739.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="VMS7KO3oDyNADhuaiB5c-24" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#374151;" value="1. Evolving Requirements: LGU disaster response protocols changed iteratively during stakeholder consultations with barangay officials. 2. Early Risk Detection: 2-week sprints exposed critical issues early (e.g., QR anti-duplicate race condition, localStorage vs AsyncStorage bug on mobile). 3. Continuous Deployment: GitHub → Vercel (web admin) and Render (backend) automated after each sprint review. 4. Stakeholder Validation: Sprint reviews with LGU officials ensured every feature matched real disaster response workflows before final deployment. 5. Working Software: Agile delivers tested, deployable increments each sprint - essential for capstone demonstration readiness." vertex="1">
          <mxGeometry height="172" width="864" x="447.20001220703125" y="771.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="VMS7KO3oDyNADhuaiB5c-25" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#0D1B2A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="SCRUM TEAM COMPOSITION" vertex="1">
          <mxGeometry height="210" width="570" x="1369.2000122070312" y="739.2000122070312" as="geometry" />
        </mxCell>
        <mxCell id="VMS7KO3oDyNADhuaiB5c-26" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#374151;" value="Product Owner: Represents LGU / DSWD stakeholder needs. Prioritizes and maintains the product backlog.  Scrum Master: Facilitates sprint ceremonies, removes blockers, enforces Agile discipline.  Development Team: Full-stack developers responsible for design, coding, testing, and deploying each feature increment across Web Admin, Backend, and Mobile platforms." vertex="1">
          <mxGeometry height="172" width="554" x="1377.2000122070312" y="771.2000122070312" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
