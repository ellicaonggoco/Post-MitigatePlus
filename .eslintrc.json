{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "max-len": "off",
    "complexity": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-undef": "off",
    "react/prop-types": "off",
    "react/display-name": "off",
    "react/no-unescaped-entities": "off",
    "import/no-unresolved": "off"
  }
}
