# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mitigateplus?retryWrites=true&w=majority

# Security (Generate a 64+ char random string for production)
JWT_SECRET=your_super_strong_random_jwt_secret_key_here_2026
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# SMS Provider (Semaphore API)
SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Push Notifications (Expo)
EXPO_PUSH_ACCESS_TOKEN=your_expo_access_token_here

# Email Provider (Nodemailer / Gmail App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
