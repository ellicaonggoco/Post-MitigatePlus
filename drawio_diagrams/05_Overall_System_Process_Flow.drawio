<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-24T01:50:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="tab-overall" name="5. Overall Process Flow">

    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ov_hdr" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: END-TO-END HOLISTIC SYSTEM PROCESS FLOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Coordinated Multi-Actor Workflow from Citizen Profiling to Checkpoint Relief Release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="50" as="geometry"/></mxCell>
        <mxCell id="ov_res" value="&lt;b style=&quot;font-size:13px; color:#1E40AF;&quot;&gt;1. REGISTERED RESIDENT&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #BFDBFE;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Registers household head &amp;amp; family roster&lt;br&gt;• Verifies mobile number via 6-digit OTP&lt;br&gt;• Accesses active Digital QR Relief Pass&lt;br&gt;• Reports structural house damage (GPS+Photo)&lt;br&gt;• Requests special care/medical packages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_brgy" value="&lt;b style=&quot;font-size:13px; color:#0F766E;&quot;&gt;2. BARANGAY OFFICIAL&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #99F6E4;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Inspects pending household queue&lt;br&gt;• Validates government ID attachment&lt;br&gt;• Approves profile &amp;amp; computes Priority Score&lt;br&gt;• Publishes &amp;amp; in-place edits advisories&lt;br&gt;• Monitors local damage &amp;amp; assistance needs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="335" y="90" width="255" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_admin" value="&lt;b style=&quot;font-size:13px; color:#B45309;&quot;&gt;3. LGU SUPERADMIN / COMMAND&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #FDE68A;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Schedules relief distribution events&lt;br&gt;• Sets global right-sized quota policies&lt;br&gt;• Monitors live Manila Risk &amp;amp; Damage Heatmap&lt;br&gt;• Superintends warehouse inventory &amp;amp; logs&lt;br&gt;• Tracks system audit trail &amp;amp; fraud alerts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="605" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_stf" value="&lt;b style=&quot;font-size:13px; color:#6D28D9;&quot;&gt;4. FIELD DISTRIBUTION STAFF&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #DDD6FE;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Scans resident QR pass at booth&lt;br&gt;• System performs anti-duplicate check&lt;br&gt;• Inspects right-sized package allocation&lt;br&gt;• Releases relief items &amp;amp; logs handover&lt;br&gt;• Reports on-ground field incidents&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_srv" value="&lt;b style=&quot;font-size:14px; color:#FFFFFF;&quot;&gt;5. CENTRAL NODE.JS API SERVER &amp;amp; MONGODB ATLAS CLUSTER&lt;/b&gt;&lt;hr style=&quot;margin:6px 0; border:0; border-top:1px solid #475569;&quot;&gt;&lt;div style=&quot;font-size:11.5px; text-align:left; color:#F8FAFC;&quot;&gt;• &lt;b&gt;Security Gateway:&lt;/b&gt; JWT RBAC Guard • Rate Limiters • Helmet Strict TLS • express-mongo-sanitize&lt;br&gt;• &lt;b&gt;Core Logic Engines:&lt;/b&gt; Multi-Factor Vulnerability Index (+5 pts Senior/PWD) • Right-Sized Quota Engine • Compound Anti-Duplicate Guard&lt;br&gt;• &lt;b&gt;Real-Time Engine:&lt;/b&gt; Socket.IO Multi-Room Broadcaster (&lt;i&gt;barangay:{code}&lt;/i&gt;, &lt;i&gt;household:{id}&lt;/i&gt;, &lt;i&gt;admin_room&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Persistence Tier:&lt;/b&gt; 15 Schema Collections in MongoDB Atlas with Compound Unique Indexes &lt;i&gt;(qrCode + eventId)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;External Gateways:&lt;/b&gt; Semaphore SMS Outbound API • Gmail SMTP Verification • OpenStreetMap Spatial Tile Service&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;verticalAlign=top;padding=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="1080" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_a1" value="&lt;b&gt;1. Register &amp;amp; OTP&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="ov_res" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a2" value="&lt;b&gt;2. Verify &amp;amp; Activate QR&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=10;fontColor=#0D9488;" edge="1" parent="1" source="ov_brgy" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a3" value="&lt;b&gt;3. Schedule &amp;amp; Policies&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="ov_admin" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a4" value="&lt;b&gt;4. Scan &amp;amp; Release Claim&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D28D9;strokeWidth=2;fontSize=10;fontColor=#6D28D9;" edge="1" parent="1" source="ov_stf" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  
  </diagram>
