        <mxCell id="m_arr10" value="&lt;b&gt;Yes&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;" edge="1" parent="1" source="m_dec" target="m_e2"><mxGeometry relative="1" as="geometry"/></mxCell>
