        <mxCell id="m_hdr" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: AGILE SCRUM DEVELOPMENT LIFECYCLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Iterative and Incremental Capstone Software Engineering Process&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1">
