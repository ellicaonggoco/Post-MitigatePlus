  <diagram id="tab_04_1" name="04.1 Process Flow - Citizen Registration & OTP">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1_hdr" value="&lt;b style=&quot;font-size:16px; color:#0F172A;&quot;&gt;WORKFLOW 4.1: CITIZEN REGISTRATION, ID ATTACHMENT &amp;amp; OTP VERIFICATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="p1_start" value="&lt;b&gt;Start: Resident Registration&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="p1_s1" value="&lt;b&gt;Step 1: Household Head Profile&lt;/b&gt;&lt;br&gt;Enter Full Name, 11-Digit Mobile / Email, Address &amp;amp; Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_s2" value="&lt;b&gt;Step 2: Attach Government Valid ID&lt;/b&gt;&lt;br&gt;Capture ID photo using Native Camera or Gallery Upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="225" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_s3" value="&lt;b&gt;Step 3: Add Family Members&lt;/b&gt;&lt;br&gt;Tag Vulnerabilities: Regular Adult, Senior, PWD, Pregnant, Infant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_s4" value="&lt;b&gt;Step 4: Request Verification OTP&lt;/b&gt;&lt;br&gt;Backend generates 6-digit cryptographic token via Semaphore/Gmail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="375" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_dec" value="&lt;b&gt;Is 6-Digit OTP Valid &amp;amp; Unexpired?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="475" y="450" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="p1_err" value="&lt;b style=&quot;color:#991B1B;&quot;&gt;Display OTP Error Notice&lt;/b&gt;&lt;br&gt;Allow 1-Tap Resend or Auto-Fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10.5;color:#991B1B;" vertex="1" parent="1"><mxGeometry x="180" y="465" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_save" value="&lt;b&gt;Save Household &amp;amp; User to MongoDB Atlas&lt;/b&gt;&lt;br&gt;Calculate initial Right-Sized Quota (Status: Pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_sock" value="&lt;b&gt;Socket.IO Broadcast Event&lt;/b&gt;&lt;br&gt;Emits &lt;i&gt;new_registration&lt;/i&gt; to Barangay Official Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="635" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_end" value="&lt;b&gt;End: Registration Submitted (Redirect to Login)&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="710" width="280" height="45" as="geometry"/></mxCell>
        <mxCell id="p1_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p1_start" target="p1_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p1_s1" target="p1_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p1_s2" target="p1_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p1_s3" target="p1_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p1_s4" target="p1_dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a6" value="&lt;b&gt;No&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#DC2626;" edge="1" parent="1" source="p1_dec" target="p1_err"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="p1_err" target="p1_s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="p1_a8" value="&lt;b&gt;Yes (Verified)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;" edge="1" parent="1" source="p1_dec" target="p1_save"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p1_save" target="p1_sock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p1_sock" target="p1_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_04_2" name="04.2 Process Flow - Barangay Verification & QR">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2_hdr" value="&lt;b style=&quot;font-size:16px; color:#0F172A;&quot;&gt;WORKFLOW 4.2: BARANGAY VERIFICATION &amp;amp; DIGITAL QR RELIEF PASS GENERATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="p2_start" value="&lt;b&gt;Start: Barangay Official Opens Verification Queue&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="320" height="45" as="geometry"/></mxCell>
        <mxCell id="p2_q" value="&lt;b&gt;Fetch Pending Registrations&lt;/b&gt;&lt;br&gt;Query MongoDB for households matching official's Barangay Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_insp" value="&lt;b&gt;Inspect Household &amp;amp; Valid ID&lt;/b&gt;&lt;br&gt;Open modal to review attached government ID and family roster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="225" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_dec" value="&lt;b&gt;Does ID &amp;amp; Demographics Match LGU Records?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="p2_rej" value="&lt;b style=&quot;color:#991B1B;&quot;&gt;Update Status = 'rejected'&lt;/b&gt;&lt;br&gt;Enter feedback reason &amp;amp; broadcast rejection notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10.5;color:#991B1B;" vertex="1" parent="1"><mxGeometry x="150" y="317" width="250" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_app" value="&lt;b style=&quot;color:#065F46;&quot;&gt;Update Status = 'verified' in Database&lt;/b&gt;&lt;br&gt;Generate Unique Encrypted QR Pass String" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;color:#065F46;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_prio" value="&lt;b&gt;Recalculate Priority Index Score&lt;/b&gt;&lt;br&gt;Apply +5 pts per Senior/PWD/Infant for distribution queue ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="495" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_sock" value="&lt;b&gt;Socket.IO Broadcast Event&lt;/b&gt;&lt;br&gt;Emits &lt;i&gt;household_verified&lt;/i&gt; to activate Resident's Mobile QR Pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="570" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_end" value="&lt;b&gt;End: Digital QR Relief Pass Successfully Issued&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="645" width="280" height="45" as="geometry"/></mxCell>
        <mxCell id="p2_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p2_start" target="p2_q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p2_q" target="p2_insp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p2_insp" target="p2_dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a4" value="&lt;b&gt;No (Invalid)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#DC2626;" edge="1" parent="1" source="p2_dec" target="p2_rej"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a5" value="&lt;b&gt;Yes (Approved)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;" edge="1" parent="1" source="p2_dec" target="p2_app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p2_app" target="p2_prio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p2_prio" target="p2_sock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p2_sock" target="p2_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_04_3" name="04.3 Process Flow - Relief Scanning & Anti-Fraud">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3_hdr" value="&lt;b style=&quot;font-size:16px; color:#0F172A;&quot;&gt;WORKFLOW 4.3: CHECKPOINT QR RELIEF SCANNING &amp;amp; REAL-TIME ANTI-DUPLICATE INTERCEPTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="p3_start" value="&lt;b&gt;Start: Resident Presents QR Pass at Distribution Booth&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="80" width="350" height="45" as="geometry"/></mxCell>
        <mxCell id="p3_scan" value="&lt;b&gt;Field Staff Scans QR Pass&lt;/b&gt;&lt;br&gt;Native Hardware Camera Scanner captures QR string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_req" value="&lt;b&gt;Dispatch Verification Request&lt;/b&gt;&lt;br&gt;POST /api/distributions/claim (eventId, qrCode, staffId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="225" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_dec" value="&lt;b&gt;Does Claim Record Exist for (qrCode + eventId)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="p3_fraud" value="&lt;b style=&quot;color:#991B1B;&quot;&gt;TRIGGER FRAUD INTERCEPTION ALERT&lt;/b&gt;&lt;br&gt;1. Block Package Handover (Screen Alert)&lt;br&gt;2. Log Duplicate Attempt in Incidents Collection&lt;br&gt;3. Emit Warning to LGU Command Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=10.5;color:#991B1B;align=left;padding=6;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="p3_quota" value="&lt;b style=&quot;color:#065F46;&quot;&gt;Display Entitled Right-Sized Quota&lt;/b&gt;&lt;br&gt;e.g. 1x Base Pack + 1x Top-Up + Infant Diapers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;color:#065F46;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_rel" value="&lt;b&gt;Staff Hands Over Physical Items &amp;amp; Confirms Release&lt;/b&gt;&lt;br&gt;Insert into Distributions &amp;amp; Decrement WarehouseStock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="495" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_sock" value="&lt;b&gt;Socket.IO Broadcast Event&lt;/b&gt;&lt;br&gt;Emits &lt;i&gt;relief_claimed&lt;/i&gt; to Live Dashboard and Resident History" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="570" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_end" value="&lt;b&gt;End: Relief Successfully Dispatched &amp;amp; Logged&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="645" width="280" height="45" as="geometry"/></mxCell>
        <mxCell id="p3_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p3_start" target="p3_scan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p3_scan" target="p3_req"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p3_req" target="p3_dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a4" value="&lt;b&gt;Yes (Already Claimed)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;" edge="1" parent="1" source="p3_dec" target="p3_fraud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a5" value="&lt;b&gt;No (First Time Claim)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;" edge="1" parent="1" source="p3_dec" target="p3_quota"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p3_quota" target="p3_rel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p3_rel" target="p3_sock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p3_sock" target="p3_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_04_4" name="04.4 Process Flow - Damage Reporting & Heatmap">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4_hdr" value="&lt;b style=&quot;font-size:16px; color:#0F172A;&quot;&gt;WORKFLOW 4.4: CITIZEN DAMAGE REPORTING &amp;amp; LGU GIS HEATMAP ASSESSMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="p4_start" value="&lt;b&gt;Start: Resident Submits House Damage Report&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="320" height="45" as="geometry"/></mxCell>
        <mxCell id="p4_s1" value="&lt;b&gt;Select Damage Severity Level&lt;/b&gt;&lt;br&gt;Minor, Moderate, Severe Damage, or Total Destruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_s2" value="&lt;b&gt;1-Tap GPS Geolocation Capture&lt;/b&gt;&lt;br&gt;Native GPS module pins Latitude &amp;amp; Longitude coordinates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="225" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_s3" value="&lt;b&gt;Attach Proof Photo via Camera / Gallery&lt;/b&gt;&lt;br&gt;Native expo-image-picker compresses evidence photo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_s4" value="&lt;b&gt;Enter Landmark &amp;amp; Dispatch Request&lt;/b&gt;&lt;br&gt;POST /api/damage-reports (Saves to MongoDB Atlas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="375" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_agg" value="&lt;b&gt;Backend Computes Barangay Structural Risk&lt;/b&gt;&lt;br&gt;Aggregates report density &amp;amp; severity weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="450" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_sock" value="&lt;b&gt;Socket.IO Real-Time Spatial Broadcast&lt;/b&gt;&lt;br&gt;Pushes updated damage pin markers to Leaflet GIS Heatmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="525" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_gis" value="&lt;b&gt;LGU Command Center Assessment&lt;/b&gt;&lt;br&gt;Disaster team visualizes high-risk zones &amp;amp; dispatches repair kits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;color:#065F46;" vertex="1" parent="1"><mxGeometry x="430" y="600" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p4_end" value="&lt;b&gt;End: Damage Logged in City Disaster Database&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="280" height="45" as="geometry"/></mxCell>
        <mxCell id="p4_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p4_start" target="p4_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p4_s1" target="p4_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p4_s2" target="p4_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p4_s3" target="p4_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p4_s4" target="p4_agg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p4_agg" target="p4_sock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p4_sock" target="p4_gis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p4_gis" target="p4_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_04_5" name="04.5 Process Flow - Special Assistance Delivery">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5_hdr" value="&lt;b style=&quot;font-size:16px; color:#0F172A;&quot;&gt;WORKFLOW 4.5: SPECIAL ASSISTANCE REQUEST &amp;amp; NUTRITION/MEDICAL ALLOCATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="p5_start" value="&lt;b&gt;Start: Resident Submits Special Assistance Request&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="340" height="45" as="geometry"/></mxCell>
        <mxCell id="p5_s1" value="&lt;b&gt;Select Special Care Item&lt;/b&gt;&lt;br&gt;Infant Formula/Diapers, Senior Medicine, Hygiene Kits, Potable Water" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_s2" value="&lt;b&gt;Enter Specific Vulnerability Notes &amp;amp; Submit&lt;/b&gt;&lt;br&gt;POST /api/assistance-requests (Status: Pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="225" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_rev" value="&lt;b&gt;Barangay &amp;amp; LGU Review Queue&lt;/b&gt;&lt;br&gt;Evaluates household eligibility &amp;amp; checks warehouse inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_dec" value="&lt;b&gt;Are Requested Care Kits In Stock?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="470" y="375" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="p5_hold" value="&lt;b style=&quot;color:#B45309;&quot;&gt;Queue Request &amp;amp; Trigger Restock Alert&lt;/b&gt;&lt;br&gt;Notify LGU Warehouse Logistics Team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=10.5;color:#B45309;" vertex="1" parent="1"><mxGeometry x="150" y="392" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_app" value="&lt;b style=&quot;color:#065F46;&quot;&gt;Approve &amp;amp; Assign to Field Delivery Team&lt;/b&gt;&lt;br&gt;Update status = 'approved' &amp;amp; decrement WarehouseStock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;color:#065F46;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_del" value="&lt;b&gt;Field Staff Delivers Special Care Kit&lt;/b&gt;&lt;br&gt;Updates request status to 'fulfilled' in AuditLogs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="565" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p5_end" value="&lt;b&gt;End: Special Medical/Nutrition Kit Received&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="640" width="280" height="45" as="geometry"/></mxCell>
        <mxCell id="p5_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p5_start" target="p5_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p5_s1" target="p5_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;" edge="1" parent="1" source="p5_s2" target="p5_rev"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="p5_rev" target="p5_dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a5" value="&lt;b&gt;Low Stock&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#B45309;" edge="1" parent="1" source="p5_dec" target="p5_hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a6" value="&lt;b&gt;In Stock&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;" edge="1" parent="1" source="p5_dec" target="p5_app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p5_app" target="p5_del"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p5_del" target="p5_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_05" name="05. Overall End-to-End Process Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ov_hdr" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: END-TO-END HOLISTIC SYSTEM PROCESS FLOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Coordinated Multi-Actor Workflow from Citizen Profiling to Checkpoint Relief Release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1080" height="50" as="geometry"/></mxCell>
        <mxCell id="ov_res" value="&lt;b style=&quot;font-size:13px; color:#1E40AF;&quot;&gt;1. REGISTERED RESIDENT&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #BFDBFE;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Registers household head &amp;amp; family roster&lt;br&gt;• Verifies mobile number via 6-digit OTP&lt;br&gt;• Accesses active Digital QR Relief Pass&lt;br&gt;• Reports structural house damage (GPS+Photo)&lt;br&gt;• Requests special care/medical packages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_brgy" value="&lt;b style=&quot;font-size:13px; color:#0F766E;&quot;&gt;2. BARANGAY OFFICIAL&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #99F6E4;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Inspects pending household queue&lt;br&gt;• Validates government ID attachment&lt;br&gt;• Approves profile &amp;amp; computes Priority Score&lt;br&gt;• Publishes &amp;amp; in-place edits advisories&lt;br&gt;• Monitors local damage &amp;amp; assistance needs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="335" y="90" width="255" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_admin" value="&lt;b style=&quot;font-size:13px; color:#B45309;&quot;&gt;3. LGU SUPERADMIN / COMMAND&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #FDE68A;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Schedules relief distribution events&lt;br&gt;• Sets global right-sized quota policies&lt;br&gt;• Monitors live Manila Risk &amp;amp; Damage Heatmap&lt;br&gt;• Superintends warehouse inventory &amp;amp; logs&lt;br&gt;• Tracks system audit trail &amp;amp; fraud alerts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="605" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_stf" value="&lt;b style=&quot;font-size:13px; color:#6D28D9;&quot;&gt;4. FIELD DISTRIBUTION STAFF&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #DDD6FE;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Scans resident QR pass at booth&lt;br&gt;• System performs anti-duplicate check&lt;br&gt;• Inspects right-sized package allocation&lt;br&gt;• Releases relief items &amp;amp; logs handover&lt;br&gt;• Reports on-ground field incidents&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_srv" value="&lt;b style=&quot;font-size:14px; color:#FFFFFF;&quot;&gt;5. CENTRAL NODE.JS API SERVER &amp;amp; MONGODB ATLAS CLUSTER&lt;/b&gt;&lt;hr style=&quot;margin:6px 0; border:0; border-top:1px solid #475569;&quot;&gt;&lt;div style=&quot;font-size:11.5px; text-align:left; color:#F8FAFC;&quot;&gt;• &lt;b&gt;Security Gateway:&lt;/b&gt; JWT RBAC Guard • Rate Limiters • Helmet Strict TLS • express-mongo-sanitize&lt;br&gt;• &lt;b&gt;Core Logic Engines:&lt;/b&gt; Multi-Factor Vulnerability Index (+5 pts Senior/PWD) • Right-Sized Quota Engine • Compound Anti-Duplicate Guard&lt;br&gt;• &lt;b&gt;Real-Time Engine:&lt;/b&gt; Socket.IO Multi-Room Broadcaster (&lt;i&gt;barangay:{code}&lt;/i&gt;, &lt;i&gt;household:{id}&lt;/i&gt;, &lt;i&gt;admin_room&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Persistence Tier:&lt;/b&gt; 15 Schema Collections in MongoDB Atlas with Compound Unique Indexes &lt;i&gt;(qrCode + eventId)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;External Gateways:&lt;/b&gt; Semaphore SMS Outbound API • Gmail SMTP Verification • OpenStreetMap Spatial Tile Service&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;verticalAlign=top;padding=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="1080" height="150" as="geometry"/></mxCell>
        <mxCell id="ov_a1" value="&lt;b&gt;1. Register &amp;amp; OTP&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="ov_res" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a2" value="&lt;b&gt;2. Verify &amp;amp; Activate QR&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=10;fontColor=#0D9488;" edge="1" parent="1" source="ov_brgy" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a3" value="&lt;b&gt;3. Schedule &amp;amp; Policies&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="ov_admin" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_a4" value="&lt;b&gt;4. Scan &amp;amp; Release Claim&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D28D9;strokeWidth=2;fontSize=10;fontColor=#6D28D9;" edge="1" parent="1" source="ov_stf" target="ov_srv"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>