    <mxCell id="1" parent="0" />
    
    <!-- Title -->
    <mxCell id="title" value="MitigatePlus — 3-Tier System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#000033;" vertex="1" parent="1">
      <mxGeometry x="100" y="30" width="1454" height="50" as="geometry" />
    </mxCell>

    <!-- TIER 1: Presentation Layer -->
    <mxCell id="tier1_band" value="TIER 1 — Presentation Layer" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;startSize=50;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="100" width="1454" height="300" as="geometry" />
    </mxCell>
    
    <mxCell id="t1_web" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Web Admin Portal (React + Vite)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Deployed on Vercel&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Role:&lt;/b&gt; LGU SuperAdmin, LGU Admin, Barangay Official&lt;br/&gt;&lt;b&gt;Pages:&lt;/b&gt; Dashboard, Verification Queue, Distribution Events, Heatmap, Relief Allocation, Warehouse, Fraud Interception, Audit Logs, Policy Config, Announcements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6C8EBF;shadow=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="tier1_band">
      <mxGeometry x="100" y="40" width="550" height="220" as="geometry" />
    </mxCell>

    <mxCell id="t1_mobile" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Mobile Application (React Native + Expo)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Platforms: Android / iOS&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Role:&lt;/b&gt; Resident/Citizen, Field Staff&lt;br/&gt;&lt;b&gt;Screens:&lt;/b&gt; Registration, QR Pass, Scanner, Damage Report, Assistance Request, Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6C8EBF;shadow=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="tier1_band">
      <mxGeometry x="800" y="40" width="550" height="220" as="geometry" />
    </mxCell>

    <!-- TIER 2: Application / Business Logic Layer -->
    <mxCell id="tier2_band" value="TIER 2 — Application / Business Logic Layer" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;startSize=50;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="480" width="1454" height="300" as="geometry" />
    </mxCell>

    <mxCell id="t2_api" value="&lt;b style=&quot;font-size:16px;&quot;&gt;REST API Server (Node.js + Express)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Hosted on Render&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Endpoints:&lt;/b&gt; /auth, /households, /distributions, /damage-reports, /incidents, /assistance-requests, /announcements, /warehouse, /audit-logs, /policy, /reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D79B00;shadow=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="tier2_band">
      <mxGeometry x="100" y="40" width="380" height="220" as="geometry" />
    </mxCell>

    <mxCell id="t2_middleware" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Middleware&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;- JWT Authentication&lt;br/&gt;- Role-Based Access Control&lt;br/&gt;&lt;i&gt;(lgu_superadmin &gt; lgu_admin &gt; barangay_official &gt; field_staff &gt; resident)&lt;/i&gt;&lt;br/&gt;- Rate Limiting&lt;br/&gt;- CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D79B00;shadow=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="tier2_band">
      <mxGeometry x="530" y="40" width="380" height="220" as="geometry" />
    </mxCell>

    <mxCell id="t2_external" value="&lt;b style=&quot;font-size:16px;&quot;&gt;External Services&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;- &lt;b&gt;SEMAPHORE SMS:&lt;/b&gt; OTP &amp; Notifications&lt;br/&gt;- &lt;b&gt;Cloudinary CDN:&lt;/b&gt; Image uploads&lt;br/&gt;- &lt;b&gt;Socket.io:&lt;/b&gt; Real-time events &amp; live updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D79B00;shadow=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="tier2_band">
      <mxGeometry x="960" y="40" width="390" height="220" as="geometry" />
    </mxCell>

    <!-- TIER 3: Data Layer -->
    <mxCell id="tier3_band" value="TIER 3 — Data Layer" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;startSize=50;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="860" width="1454" height="250" as="geometry" />
    </mxCell>

    <mxCell id="t3_db" value="&lt;b style=&quot;font-size:16px;&quot;&gt;MongoDB Atlas (Cloud Database)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Mongoose ODM&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Collections:&lt;/b&gt; Users, Households, DistributionEvents, Distributions, DamageReports, Incidents, AssistanceRequests, Announcements, AuditLogs, PolicyConfig, WarehouseItems, WarehouseLogs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#82B366;shadow=1;align=center;spacing=10;" vertex="1" parent="tier3_band">
      <mxGeometry x="400" y="30" width="700" height="180" as="geometry" />
    </mxCell>

    <!-- Connectors -->
    <mxCell id="edge_t1_t2" value="HTTPS REST API Calls / WebSocket" style="endArrow=classic;startArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=16;fontStyle=1;" edge="1" parent="1" source="tier1_band" target="tier2_band">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="827" y="420" as="sourcePoint" />
        <mxPoint x="827" y="470" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    
    <mxCell id="edge_t2_t3" value="Mongoose ODM Queries / MongoDB Wire Protocol" style="endArrow=classic;startArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=16;fontStyle=1;" edge="1" parent="1" source="tier2_band" target="tier3_band">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="827" y="790" as="sourcePoint" />
        <mxPoint x="827" y="850" as="targetPoint" />
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>
