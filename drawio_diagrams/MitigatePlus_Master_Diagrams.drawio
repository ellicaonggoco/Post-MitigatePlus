          <mxGeometry x="420" y="25" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fd_r1" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;1. LGU SuperAdmin / Head&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E40AF;align=center;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="fd_r1_box" value="&lt;b style=&quot;color:#1E40AF;&quot;&gt;Executive &amp;amp; Strategic Modules:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0; padding-left:18px; text-align:left; font-size:11px; color:#334155;&quot;&gt;&lt;li&gt;&lt;b&gt;Executive Dashboard:&lt;/b&gt; City Metrics&lt;/li&gt;&lt;li&gt;&lt;b&gt;GIS Risk Heatmap:&lt;/b&gt; Spatial Damage&lt;/li&gt;&lt;li&gt;&lt;b&gt;Relief Operations:&lt;/b&gt; Schedule Events&lt;/li&gt;&lt;li&gt;&lt;b&gt;Warehouse Inventory:&lt;/b&gt; Stock Logs&lt;/li&gt;&lt;li&gt;&lt;b&gt;Security &amp;amp; Governance:&lt;/b&gt; Audit Logs&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;align=left;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="fd_r2" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;2. Barangay Official&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;align=center;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="fd_r2_box" value="&lt;b style=&quot;color:#0D9488;&quot;&gt;Barangay Operations Modules:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0; padding-left:18px; text-align:left; font-size:11px; color:#334155;&quot;&gt;&lt;li&gt;&lt;b&gt;Household Verification Queue&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Inspect Attached Valid IDs&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Priority Index Ranking&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Manage Vulnerability Tags&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;In-Place Edit Advisories&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#99F6E4;align=left;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="165" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="fd_r3" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;3. Field Distribution Staff&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;align=center;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="115" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="fd_r3_box" value="&lt;b style=&quot;color:#D97706;&quot;&gt;On-Ground Checkpoint Modules:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0; padding-left:18px; text-align:left; font-size:11px; color:#334155;&quot;&gt;&lt;li&gt;&lt;b&gt;Hardware Camera QR Scanner&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Anti-Duplicate Checkpoint Guard&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Right-Sized Quota Release&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Log Physical Item Handover&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Report On-Ground Incidents&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;align=left;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="165" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="fd_r4" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;4. Registered Resident&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#6D28D9;align=center;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="115" width="240" height="40" as="geometry"/></mxCell>
        <mxCell id="fd_r4_box" value="&lt;b style=&quot;color:#6D28D9;&quot;&gt;Citizen &amp;amp; Resident Modules:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0; padding-left:18px; text-align:left; font-size:11px; color:#334155;&quot;&gt;&lt;li&gt;&lt;b&gt;Household Profiling &amp;amp; OTP Auth&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Digital Encrypted QR Relief Pass&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Report Structural Damage (GPS)&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Request Special Medical Kits&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;View Live Claims &amp;amp; Advisories&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;align=left;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="165" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="fd_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="fd_root" target="fd_r1"><mxGeometry relative="1" as="geometry"/></mxCell>
