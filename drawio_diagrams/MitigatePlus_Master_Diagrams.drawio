  <diagram id="tab_02" name="02. Agile Scrum Methodology">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    
    <!-- Title -->
    <mxCell id="title" value="MitigatePlus — Agile/Scrum Development Methodology" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#000033;" vertex="1" parent="1">
      <mxGeometry x="100" y="50" width="1454" height="50" as="geometry" />
    </mxCell>

    <!-- Scrum Cycle Elements -->
    <mxCell id="scrum_1" value="&lt;b style=&quot;font-size:16px;&quot;&gt;1. PRODUCT BACKLOG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;All system requirements: User registration, QR distribution, Heatmap, Fraud detection, etc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="150" y="200" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="scrum_2" value="&lt;b style=&quot;font-size:16px;&quot;&gt;2. SPRINT PLANNING&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Team selects items from backlog for 2-week sprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="550" y="200" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="scrum_3" value="&lt;b style=&quot;font-size:16px;&quot;&gt;3. SPRINT BACKLOG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Sprint tasks broken into daily items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="950" y="200" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="scrum_4" value="&lt;b style=&quot;font-size:16px;&quot;&gt;4. SPRINT EXECUTION&lt;/b&gt;&lt;br/&gt;(2 weeks)&lt;br/&gt;&lt;br/&gt;Inner cycle:&lt;br/&gt;Design → Code → Test → Deploy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="1300" y="325" width="250" height="250" as="geometry" />
    </mxCell>

    <mxCell id="scrum_5" value="&lt;b style=&quot;font-size:16px;&quot;&gt;5. DAILY SCRUM&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Daily 15-min standup:&lt;br/&gt;What did, what will do, blockers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="950" y="550" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="scrum_6" value="&lt;b style=&quot;font-size:16px;&quot;&gt;6. SPRINT REVIEW&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Demo working features to stakeholders (LGU officials)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="550" y="550" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="scrum_7" value="&lt;b style=&quot;font-size:16px;&quot;&gt;7. SPRINT RETROSPECTIVE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Team improves process for next sprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="150" y="550" width="280" height="150" as="geometry" />
    </mxCell>

    <!-- Connectors -->
    <mxCell id="edge_1_2" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="scrum_1" target="scrum_2">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>
    
    <mxCell id="edge_2_3" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="scrum_2" target="scrum_3">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>
    
    <mxCell id="edge_3_4" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="scrum_3" target="scrum_4">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_4_5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="scrum_4" target="scrum_5">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>
    
    <mxCell id="edge_5_6" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="scrum_5" target="scrum_6">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_6_7" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="scrum_6" target="scrum_7">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_7_2" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="scrum_7" target="scrum_2">
      <mxGeometry width="50" height="50" relative="1" as="geometry" />
    </mxCell>

    <!-- Additional Info Boxes -->
    <mxCell id="roles_box" value="&lt;b style=&quot;font-size:18px;&quot;&gt;TEAM ROLES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;- &lt;b&gt;Product Owner:&lt;/b&gt; Manages product backlog, represents LGU stakeholders&lt;br/&gt;- &lt;b&gt;Scrum Master:&lt;/b&gt; Facilitates sprints, removes blockers&lt;br/&gt;- &lt;b&gt;Development Team:&lt;/b&gt; Designs, codes, tests, and deploys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;shadow=1;align=left;spacing=15;" vertex="1" parent="1">
      <mxGeometry x="150" y="800" width="680" height="180" as="geometry" />
    </mxCell>

    <mxCell id="why_agile_box" value="&lt;b style=&quot;font-size:18px;&quot;&gt;WHY AGILE/SCRUM FOR MITIGATEPLUS?&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;1. Requirements evolved progressively from LGU stakeholder feedback&lt;br/&gt;2. Iterative sprints allowed features to be tested and adjusted early&lt;br/&gt;3. Frequent reviews ensured alignment with government disaster response needs&lt;br/&gt;4. Continuous GitHub → Vercel/Render integration enabled rapid deployment&lt;br/&gt;5. Flexibility to respond to regulatory and compliance changes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFACD;strokeColor=#D6B656;shadow=1;align=left;spacing=15;" vertex="1" parent="1">
      <mxGeometry x="880" y="800" width="670" height="180" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
  </diagram>
