        <mxCell id="m_arr7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="m_p1_c3" target="m_p2"><mxGeometry relative="1" as="geometry"/></mxCell>
