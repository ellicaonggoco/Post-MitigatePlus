  <diagram id="tab-meth" name="2. Agile Methodology">

    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="m_hdr" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: AGILE SCRUM DEVELOPMENT LIFECYCLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Iterative and Incremental Capstone Software Engineering Process&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1080" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m_p1" value="&lt;b style=&quot;font-size:13px; color:#1E40AF;&quot;&gt;PHASE 1: PRODUCT BACKLOG &amp;amp; REQUIREMENTS GATHERING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m_p1_c1" value="&lt;b&gt;1. Stakeholder Interviews&lt;/b&gt;&lt;br&gt;Analyze DSWD &amp;amp; Manila LGU Relief Quota Guidelines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;color:#334155;" vertex="1" parent="1"><mxGeometry x="80" y="155" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="m_p1_c2" value="&lt;b&gt;2. User Persona Modeling&lt;/b&gt;&lt;br&gt;SuperAdmin, Barangay Official, Field Staff, Resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;color:#334155;" vertex="1" parent="1"><mxGeometry x="440" y="155" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="m_p1_c3" value="&lt;b&gt;3. Product Backlog Creation&lt;/b&gt;&lt;br&gt;Prioritized Epics &amp;amp; Acceptance Criteria User Stories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;color:#334155;" vertex="1" parent="1"><mxGeometry x="800" y="155" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="m_p2" value="&lt;b style=&quot;font-size:13px; color:#0F766E;&quot;&gt;PHASE 2: AGILE SPRINT EXECUTION (2-WEEK ITERATIONS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m_s1" value="&lt;b&gt;1. Sprint Planning&lt;/b&gt;&lt;br&gt;Select sprint user stories &amp;amp; allocate team tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="m_s2" value="&lt;b&gt;2. UI/UX &amp;amp; Schema Design&lt;/b&gt;&lt;br&gt;Wireframing &amp;amp; Mongoose database schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="300" y="310" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="m_s3" value="&lt;b&gt;3. Full-Stack Dev&lt;/b&gt;&lt;br&gt;React 18, React Native, Node.js API, Sockets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="520" y="310" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="m_s4" value="&lt;b&gt;4. Testing &amp;amp; Audit&lt;/b&gt;&lt;br&gt;Anti-duplicate stress test, rate limit verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="740" y="310" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="m_s5" value="&lt;b&gt;5. Review &amp;amp; Retrospect&lt;/b&gt;&lt;br&gt;Demonstration &amp;amp; backlog refinement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;color:#0F172A;" vertex="1" parent="1"><mxGeometry x="960" y="310" width="160" height="70" as="geometry"/></mxCell>
