<mxfile host="app.diagrams.net" modified="2026-08-24T01:25:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="arch-tier" name="Three-Tier System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE BAR -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: THREE-TIER SYSTEM ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Post-Disaster Mitigation, Household Profiling, and Real-Time Relief Distribution Management Platform&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1080" height="50" as="geometry"/>
        </mxCell>

        <!-- ===================================================== -->
        <!-- TIER 1: PRESENTATION LAYER -->
        <!-- ===================================================== -->
        <mxCell id="tier1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1080" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="tier1_label" value="&lt;b style=&quot;color:#1E40AF; font-size:13px;&quot;&gt;1. PRESENTATION LAYER (CLIENT APPLICATIONS &amp;amp; USER INTERFACES)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="96" width="600" height="24" as="geometry"/>
        </mxCell>

        <!-- Web Admin Card -->
        <mxCell id="c_web" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Web Admin &amp;amp; Command Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#1D4ED8; font-weight:700;&quot;&gt;React 18 • Vite • Leaflet GIS • Recharts&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Real-Time Manila Disaster Dashboard&lt;br&gt;• Spatial Risk &amp;amp; Damage Heatmap&lt;br&gt;• Household Verification Queue &amp;amp; Priority Index&lt;br&gt;• Relief Allocation &amp;amp; Warehouse Inventory&lt;br&gt;• Real-Time Socket.IO Notification Listener&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="340" height="100" as="geometry"/>
        </mxCell>

        <!-- Mobile Resident Card -->
        <mxCell id="c_mob_res" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Resident Mobile Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#1D4ED8; font-weight:700;&quot;&gt;React Native • Expo • AsyncStorage&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Digital Encrypted QR Relief Pass&lt;br&gt;• Structural Damage Report (GPS + Camera)&lt;br&gt;• Special Care &amp;amp; Medical Requests&lt;br&gt;• Real-Time Claim History &amp;amp; Advisories&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="125" width="310" height="100" as="geometry"/>
        </mxCell>

        <!-- Mobile Staff Card -->
        <mxCell id="c_mob_stf" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Field Staff Scanner Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#1D4ED8; font-weight:700;&quot;&gt;Expo-Camera • Native Sensors&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Hardware QR Code Camera Scanner&lt;br&gt;• Instant Entitled Quota Verification&lt;br&gt;• Anti-Duplicate Claim Interception&lt;br&gt;• 1-Tap Relief Release &amp;amp; Audit Logger&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="125" width="330" height="100" as="geometry"/>
        </mxCell>

        <!-- ===================================================== -->
        <!-- TIER 2: APPLICATION & BUSINESS LOGIC LAYER -->
        <!-- ===================================================== -->
        <mxCell id="tier2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="1080" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="tier2_label" value="&lt;b style=&quot;color:#0F766E; font-size:13px;&quot;&gt;2. APPLICATION &amp;amp; BUSINESS LOGIC LAYER (NODE.JS &amp;amp; EXPRESS.JS SERVER)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="296" width="600" height="24" as="geometry"/>
        </mxCell>

        <!-- Security Gateway -->
        <mxCell id="c_sec" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Security &amp;amp; Ingress Gateway&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• JWT Auth &amp;amp; 5-Role RBAC Guard&lt;br&gt;• Helmet Strict TLS Headers&lt;br&gt;• Multi-Tier Rate Limiters (Auth, OTP)&lt;br&gt;• express-mongo-sanitize (NoSQL)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="325" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- REST API Controllers -->
        <mxCell id="c_api" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;REST API Controllers (12 Routes)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• &lt;b&gt;/auth&lt;/b&gt; (Login, Register, 6-Digit OTP)&lt;br&gt;• &lt;b&gt;/households&lt;/b&gt; (Profiling &amp;amp; Approvals)&lt;br&gt;• &lt;b&gt;/distributions&lt;/b&gt; (Events &amp;amp; Claiming)&lt;br&gt;• &lt;b&gt;/damage-reports&lt;/b&gt; (GIS Data &amp;amp; Photos)&lt;br&gt;• &lt;b&gt;/assistance-requests&lt;/b&gt; (Special Care)&lt;br&gt;• &lt;b&gt;/warehouse&lt;/b&gt; (Inventory In/Out Logs)&lt;br&gt;• &lt;b&gt;/audit-logs&lt;/b&gt; &amp;amp; &lt;b&gt;/policy&lt;/b&gt; (Governance)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="325" width="250" height="180" as="geometry"/>
        </mxCell>

        <!-- Core Computational Engines -->
        <mxCell id="c_eng" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Computational Engines&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• &lt;b&gt;Smart Priority Index Engine&lt;/b&gt;&lt;br&gt;  (+5 pts Senior/PWD/Infant + Damage)&lt;br&gt;• &lt;b&gt;Right-Sized Relief Allocation&lt;/b&gt;&lt;br&gt;  (1-4 pax = 1 Base, 5+ = Base + Top-Up)&lt;br&gt;• &lt;b&gt;Anti-Duplicate Fraud Guard&lt;/b&gt;&lt;br&gt;  (Compound Index Clamping)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="325" width="250" height="180" as="geometry"/>
        </mxCell>

        <!-- Socket.IO Engine -->
        <mxCell id="c_sock" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Socket.IO Event Engine&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• Full-Duplex WebSockets&lt;br&gt;• Multi-Room Multiplexing:&lt;br&gt;  - &lt;i&gt;barangay:{code}&lt;/i&gt;&lt;br&gt;  - &lt;i&gt;household:{id}&lt;/i&gt;&lt;br&gt;  - &lt;i&gt;admin_room&lt;/i&gt;&lt;br&gt;• Real-Time Push Alerts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="325" width="260" height="180" as="geometry"/>
        </mxCell>

        <!-- ===================================================== -->
        <!-- TIER 3: DATA & EXTERNAL SERVICES LAYER -->
        <!-- ===================================================== -->
        <mxCell id="tier3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="1080" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="tier3_label" value="&lt;b style=&quot;color:#B45309; font-size:13px;&quot;&gt;3. DATA &amp;amp; EXTERNAL SERVICES LAYER (PERSISTENCE &amp;amp; CLOUD INTEGRATIONS)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="576" width="600" height="24" as="geometry"/>
        </mxCell>

        <!-- MongoDB Database Card -->
        <mxCell id="c_db" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;MongoDB Atlas Cloud Database (15 Mongoose Schema Collections)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155;&quot;&gt;• &lt;b&gt;Users&lt;/b&gt; • &lt;b&gt;Households&lt;/b&gt; • &lt;b&gt;DistributionEvents&lt;/b&gt; • &lt;b&gt;Distributions&lt;/b&gt; • &lt;b&gt;AssistanceRequests&lt;/b&gt; • &lt;b&gt;DamageReports&lt;/b&gt;&lt;br&gt;• &lt;b&gt;WarehouseItems&lt;/b&gt; • &lt;b&gt;WarehouseLogs&lt;/b&gt; • &lt;b&gt;AuditLogs&lt;/b&gt; • &lt;b&gt;Incidents&lt;/b&gt; • &lt;b&gt;PolicyConfigs&lt;/b&gt; • &lt;b&gt;RecoveryStatuses&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Announcements&lt;/b&gt; • &lt;b&gt;OtpTokens&lt;/b&gt; • &lt;b&gt;ReliefItemTypes&lt;/b&gt; | &lt;span style=&quot;color:#DC2626; font-weight:700;&quot;&gt;Compound Unique Indexes (qrCode + eventId)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="605" width="600" height="120" as="geometry"/>
        </mxCell>

        <!-- External Services Card -->
        <mxCell id="c_ext" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;External Cloud Gateways&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155;&quot;&gt;• &lt;b&gt;Semaphore SMS Gateway:&lt;/b&gt; Outbound OTP &amp;amp; Alerts&lt;br&gt;• &lt;b&gt;Gmail SMTP / Nodemailer:&lt;/b&gt; Cloud Email Verification&lt;br&gt;• &lt;b&gt;OpenStreetMap Tile Servers:&lt;/b&gt; GIS Map Geometry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="605" width="420" height="120" as="geometry"/>
        </mxCell>

        <!-- ===================================================== -->
        <!-- CLEAN ORTHOGONAL CONNECTORS -->
        <!-- ===================================================== -->
        <!-- Tier 1 to Tier 2 (REST API & WebSockets) -->
        <mxCell id="conn_1" value="&lt;b&gt;HTTPS REST (JSON Payload)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="c_web" target="c_sec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="260"/>
              <mxPoint x="190" y="260"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_2" value="&lt;b&gt;HTTPS REST / Auth&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="c_mob_res" target="c_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_3" value="&lt;b&gt;WSS WebSockets (Live Events)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=10;fontColor=#0D9488;dashed=1;" edge="1" parent="1" source="c_mob_stf" target="c_sock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tier 2 Internal Flow -->
        <mxCell id="conn_int1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="c_sec" target="c_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="conn_int2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="c_api" target="c_eng">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="conn_int3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="c_eng" target="c_sock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tier 2 to Tier 3 -->
        <mxCell id="conn_db" value="&lt;b&gt;Mongoose Queries / CRUD Transactions&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="c_api" target="c_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="445" y="540"/>
              <mxPoint x="380" y="540"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_ext" value="&lt;b&gt;HTTPS Outbound API / Encrypted SMTP&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6D28D9;strokeWidth=2;fontSize=10;fontColor=#6D28D9;" edge="1" parent="1" source="c_eng" target="c_ext">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="715" y="540"/>
              <mxPoint x="910" y="540"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
