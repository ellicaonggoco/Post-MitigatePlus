  <diagram id="tab-arch" name="1. System Architecture">

    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a_hdr" value="&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;MITIGATEPLUS: THREE-TIER SYSTEM ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Post-Disaster Mitigation, Household Profiling, and Real-Time Relief Distribution Management Platform&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1080" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a_t1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1080" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="a_t1_lbl" value="&lt;b style=&quot;color:#1E40AF; font-size:13px;&quot;&gt;1. PRESENTATION LAYER (CLIENT APPLICATIONS &amp;amp; USER INTERFACES)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="96" width="600" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="a_web" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Web Admin &amp;amp; Command Center Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px; color:#1D4ED8; font-weight:700;&quot;&gt;React 18 • Vite • Leaflet GIS • Recharts&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Real-Time Manila Disaster Dashboard&lt;br&gt;• Spatial Risk &amp;amp; Damage Heatmap&lt;br&gt;• Household Verification Queue &amp;amp; Priority Index&lt;br&gt;• Relief Allocation &amp;amp; Warehouse Inventory&lt;br&gt;• Real-Time Socket.IO Notification Panel&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="340" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a_mob_res" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Resident Mobile Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px; color:#1D4ED8; font-weight:700;&quot;&gt;React Native • Expo • AsyncStorage&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Digital Encrypted QR Relief Pass&lt;br&gt;• Structural Damage Report (GPS + Camera)&lt;br&gt;• Special Care &amp;amp; Medical Requests&lt;br&gt;• Real-Time Claim History &amp;amp; Advisories&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="125" width="310" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a_mob_stf" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Field Staff Scanner Portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px; color:#1D4ED8; font-weight:700;&quot;&gt;Expo-Camera • Native Sensors&lt;/span&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:11px; text-align:left; color:#334155;&quot;&gt;• Hardware Camera QR Code Scanner&lt;br&gt;• Instant Entitled Quota Verification&lt;br&gt;• Anti-Duplicate Claim Interception&lt;br&gt;• 1-Tap Relief Release &amp;amp; Audit Logger&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="125" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a_t2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="295" width="1080" height="235" as="geometry"/>
        </mxCell>
        <mxCell id="a_t2_lbl" value="&lt;b style=&quot;color:#0F766E; font-size:13px;&quot;&gt;2. APPLICATION &amp;amp; BUSINESS LOGIC LAYER (NODE.JS &amp;amp; EXPRESS.JS SERVER)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="301" width="600" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="a_sec" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Security &amp;amp; Ingress Gateway&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• JWT Auth &amp;amp; 5-Role RBAC Guard&lt;br&gt;• Helmet Strict TLS Headers&lt;br&gt;• Multi-Tier Rate Limiters (Auth, OTP)&lt;br&gt;• express-mongo-sanitize (NoSQL)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="220" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="a_api" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;REST API Controllers (12 Routes)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• &lt;b&gt;/auth&lt;/b&gt; (Login, Register, 6-Digit OTP)&lt;br&gt;• &lt;b&gt;/households&lt;/b&gt; (Profiling &amp;amp; Approvals)&lt;br&gt;• &lt;b&gt;/distributions&lt;/b&gt; (Events &amp;amp; Claiming)&lt;br&gt;• &lt;b&gt;/damage-reports&lt;/b&gt; (GIS Data &amp;amp; Photos)&lt;br&gt;• &lt;b&gt;/assistance-requests&lt;/b&gt; (Special Care)&lt;br&gt;• &lt;b&gt;/warehouse&lt;/b&gt; (Inventory In/Out Logs)&lt;br&gt;• &lt;b&gt;/audit-logs&lt;/b&gt; &amp;amp; &lt;b&gt;/policy&lt;/b&gt; (Governance)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="250" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="a_eng" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Core Computational Engines&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• &lt;b&gt;Smart Priority Index Engine&lt;/b&gt;&lt;br&gt;  (+5 pts Senior/PWD/Infant + Damage)&lt;br&gt;• &lt;b&gt;Right-Sized Relief Allocation&lt;/b&gt;&lt;br&gt;  (1-4 pax = 1 Base, 5+ = Base + Top-Up)&lt;br&gt;• &lt;b&gt;Anti-Duplicate Fraud Guard&lt;/b&gt;&lt;br&gt;  (Compound Index Clamping)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="330" width="250" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="a_sock" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Socket.IO Event Engine&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155; margin-top:4px;&quot;&gt;• Full-Duplex WebSockets&lt;br&gt;• Multi-Room Multiplexing:&lt;br&gt;  - &lt;i&gt;barangay:{code}&lt;/i&gt;&lt;br&gt;  - &lt;i&gt;household:{id}&lt;/i&gt;&lt;br&gt;  - &lt;i&gt;admin_room&lt;/i&gt;&lt;br&gt;• Real-Time Push Alerts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="260" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="a_t3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1080" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="a_t3_lbl" value="&lt;b style=&quot;color:#B45309; font-size:13px;&quot;&gt;3. DATA &amp;amp; EXTERNAL SERVICES LAYER (PERSISTENCE &amp;amp; CLOUD INTEGRATIONS)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="586" width="600" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="a_db" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;MongoDB Atlas Cloud Database (15 Mongoose Schema Collections)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155;&quot;&gt;• &lt;b&gt;Users&lt;/b&gt; • &lt;b&gt;Households&lt;/b&gt; • &lt;b&gt;DistributionEvents&lt;/b&gt; • &lt;b&gt;Distributions&lt;/b&gt; • &lt;b&gt;AssistanceRequests&lt;/b&gt; • &lt;b&gt;DamageReports&lt;/b&gt;&lt;br&gt;• &lt;b&gt;WarehouseItems&lt;/b&gt; • &lt;b&gt;WarehouseLogs&lt;/b&gt; • &lt;b&gt;AuditLogs&lt;/b&gt; • &lt;b&gt;Incidents&lt;/b&gt; • &lt;b&gt;PolicyConfigs&lt;/b&gt; • &lt;b&gt;RecoveryStatuses&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Announcements&lt;/b&gt; • &lt;b&gt;OtpTokens&lt;/b&gt; • &lt;b&gt;ReliefItemTypes&lt;/b&gt; | &lt;span style=&quot;color:#DC2626; font-weight:700;&quot;&gt;Compound Unique Indexes (qrCode + eventId)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="615" width="600" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="a_ext" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;External Cloud Gateways&lt;/b&gt;&lt;hr style=&quot;margin:4px 0; border:0; border-top:1px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;font-size:10.5px; text-align:left; color:#334155;&quot;&gt;• &lt;b&gt;Semaphore SMS Gateway:&lt;/b&gt; Outbound OTP &amp;amp; Alerts&lt;br&gt;• &lt;b&gt;Gmail SMTP / Nodemailer:&lt;/b&gt; Cloud Email Verification&lt;br&gt;• &lt;b&gt;OpenStreetMap Tile Servers:&lt;/b&gt; GIS Map Geometry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;padding=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="615" width="420" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="a_c1" value="&lt;b&gt;HTTPS REST (JSON)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="a_web" target="a_sec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_c2" value="&lt;b&gt;HTTPS REST&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="a_mob_res" target="a_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_c3" value="&lt;b&gt;WSS WebSockets&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=10;fontColor=#0D9488;dashed=1;" edge="1" parent="1" source="a_mob_stf" target="a_sock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_c4" value="&lt;b&gt;Mongoose ODM Transactions&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="a_api" target="a_db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="550"/><mxPoint x="380" y="550"/></Array></mxGeometry></mxCell>
        <mxCell id="a_c5" value="&lt;b&gt;External Outbound Gateways&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6D28D9;strokeWidth=2;fontSize=10;fontColor=#6D28D9;" edge="1" parent="1" source="a_eng" target="a_ext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="550"/><mxPoint x="910" y="550"/></Array></mxGeometry></mxCell>
      </root>
