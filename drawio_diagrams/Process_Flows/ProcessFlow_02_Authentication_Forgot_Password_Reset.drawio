<mxCell id="n2" value="Inputs Phone/Email &amp;amp;&lt;br&gt;Password or Taps 'Forgot'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;" vertex="1" parent="lane_usr"><mxGeometry x="160" y="45" width="140" height="50" as="geometry"/></mxCell>
