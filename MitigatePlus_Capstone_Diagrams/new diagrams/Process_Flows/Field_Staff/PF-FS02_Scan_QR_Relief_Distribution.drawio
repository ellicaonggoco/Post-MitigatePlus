    <mxCell id="x0019" value="Display &quot;VERIFIED BENEFICIARY&quot;; Staff hands over physical relief package" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="570" width="380" height="65" as="geometry"/></mxCell>
