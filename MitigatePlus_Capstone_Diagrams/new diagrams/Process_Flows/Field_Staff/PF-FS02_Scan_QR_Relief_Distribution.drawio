    <mxCell id="x0011" value="&lt;b&gt;PF-FS02: Process Flow - Scan QR for Relief Distribution&lt;/b&gt;&lt;br&gt;Actor: Field Staff     Linked Use Case: UC-FS02" style="text;html=1;strokeColor=#1557B0;fillColor=#EFF6FF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="14" width="640" height="52" as="geometry"/></mxCell>
    <mxCell id="x0012" value="START: Field Staff opens StaffScannerScreen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;arcSize=45;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="85" width="380" height="65" as="geometry"/></mxCell>
    <mxCell id="x0013" value="Selects active distribution event from GET /api/distributions/events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="175" width="380" height="65" as="geometry"/></mxCell>
    <mxCell id="x0014" value="Scans resident digital QR Relief Pass using camera scanner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="265" width="380" height="65" as="geometry"/></mxCell>
    <mxCell id="x0015" value="App calls POST /api/distributions/release with { eventId, householdId, qrCode }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="355" width="380" height="65" as="geometry"/></mxCell>
    <mxCell id="x0016" value="Already claimed in event?&lt;br&gt;(Compound index check)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="280" height="90" as="geometry"/></mxCell>
    <mxCell id="x0017" value="Display &quot;DUPLICATE CLAIM DETECTED&quot; red warning alert;&lt;br&gt;log fraud incident to Fraud Interception stream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#f87171;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="300" height="75" as="geometry"/></mxCell>
