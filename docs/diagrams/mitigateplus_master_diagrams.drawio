      <mxCell id="t1" value="MITIGATEPLUS: 3-TIER SYSTEM ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0B2E59;" parent="1" vertex="1"><mxGeometry x="400" y="30" width="1000" height="35" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="t2" value="Hierarchical Multi-Portal Disaster Recovery Platform for the City of Manila" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" parent="1" vertex="1"><mxGeometry x="400" y="65" width="1000" height="25" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="l1" value="TIER 1: PRESENTATION LAYER (Client Interfaces &amp; End-User Portals)" style="swimlane;startSize=35;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontSize=15;fontColor=#0F172A;rounded=1;arcSize=6;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="110" width="1680" height="330" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w_box" value="LGU Web Command Center (React 18 + Vite + SPA Router)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l1" vertex="1"><mxGeometry x="40" y="50" width="780" height="250" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w1" value="• LGU SuperAdmin Portal: Executive Dashboard, Global Policy Formula, Account Security, Audit Exporter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="60" y="90" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w2" value="• LGU Operations Admin Portal: City Risk Heatmap (GIS TopoJSON), Distribution Events, Central Warehouse, Fraud Interception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="60" y="128" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w3" value="• Barangay Official Portal: Real-Time Resident Verification Queue, 5-Stage Recovery Tracker, Special Relief Requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="60" y="166" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w4" value="• Real-Time WebSocket Client (Socket.IO-Client): Instant Fraud Alerts, Queue Sync, Recovery Progression Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="60" y="204" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="w5" value="• UI Foundation: Modular Claymorphic/Neumorphic Design System, Recharts Visualization, Leaflet GIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="60" y="242" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m_box" value="Mobile Client Application (React Native + Expo SDK 51)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l1" vertex="1"><mxGeometry x="860" y="50" width="780" height="250" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m1" value="• Resident Citizen Portal: Singpass-Style Offline QR Relief Pass, Household Roster Manager, Biometrics Lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="880" y="90" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m2" value="• Post-Disaster Damage Reporting: 4-Level Severity Grid, Camera Photo Evidence Upload, Landmark Geotagging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="880" y="128" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m3" value="• Relief Quota Request &amp; Timeline: Headcount-scaled quota request, Real-time status stepper, Claims history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="880" y="166" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m4" value="• Field Staff Portal &amp; QR Scanner: On-Site QR Verification, Duplicate Claim Interception, Offline Scanner Buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="880" y="204" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="m5" value="• Door-to-Door Delivery &amp; Incidents: Bedridden/PWD special assignment delivery, On-ground incident logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l1" vertex="1"><mxGeometry x="880" y="242" width="740" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="l2" value="TIER 2: APPLICATION &amp; BUSINESS LOGIC LAYER (Express.js + Node.js + Algorithmic Engines)" style="swimlane;startSize=35;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontStyle=1;fontSize=15;fontColor=#0F172A;rounded=1;arcSize=6;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="480" width="1680" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw_box" value="API Gateway &amp; Security Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l2" vertex="1"><mxGeometry x="40" y="50" width="360" height="340" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw1" value="• JWT Authentication &amp; Bcrypt Hashing (10 rounds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="90" width="330" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw2" value="• Role-Based Access Control (RBAC Middleware):
  [SuperAdmin, Admin, Official, Staff, Resident]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="132" width="330" height="42" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw3" value="• Geographic Isolation (requireBarangayScope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="180" width="330" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw4" value="• Rate Limiting (express-rate-limit):
  100 req/15min API, 20 req/15min Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="222" width="330" height="42" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw5" value="• Dynamic CORS &amp; Health Check Endpoint (/api/health)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="270" width="330" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="gw6" value="• Automated System Bootstrap (SuperAdmin, Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="55" y="312" width="330" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng_box" value="Core Algorithmic Engines &amp; Real-Time Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l2" vertex="1"><mxGeometry x="430" y="50" width="620" height="340" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng1" value="1. Smart Priority Index Engine (priorityIndex.js):
   Score = (Damage * 10) + VulnerabilityPoints + min(Days, 30) - Penalty
   High (&gt;=50), Medium (25-49), Low (&lt;25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="445" y="90" width="590" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng2" value="2. Right-Sized Relief Allocation Engine (reliefAllocation.js):
   BasePacks = max(1, floor(n / c)), TopUpUnits = max(0, n - (BasePacks * c))
   Calculates dynamic packs per household composition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="445" y="146" width="590" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng3" value="3. Anti-Duplicate Claim Enforcement Engine (distributionRoutes.js):
   Atomic compound index check + real-time 409 conflict trigger
   Auto-emits duplicate_claim_alert to Command Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="445" y="202" width="590" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng4" value="4. Assistance Gap Detection Engine (gapDetection.js):
   Analyzes 7 standard relief categories against fulfilled distributions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="445" y="258" width="590" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="eng5" value="5. Real-Time WebSocket Hub (Socket.IO):
   Rooms: barangay:&lt;code &gt;, household:&lt;id &gt;, admin_room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="445" y="300" width="590" height="40" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="rt_box" value="12 Modular Route Handlers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l2" vertex="1"><mxGeometry x="1080" y="50" width="560" height="340" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="rt1" value="• /api/auth: Registration, Login, Provisioning, OTP verification
• /api/households: Verification Queue, Profile, QR Scanner Lookup
• /api/distributions: Event Dispatch, Right-Sized Relief Release
• /api/assistance-requests: Citizen Requests &amp; Door-to-Door Tasks
• /api/damage-reports: Citizen Damage Reports &amp; Staff Validation
• /api/warehouse: Central Inventory, Restock (+), Dispatch (-), Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="1095" y="90" width="530" height="110" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="rt2" value="• /api/recovery: 5-Stage Household Recovery Status Management
• /api/incidents: Field Loggers &amp; Evacuation Incident Reports
• /api/announcements: Civic Alerts with Mobile Deep-Link Triggers
• /api/reports: Executive KPIs, Blocked Duplicate Trails, Gap Matrix
• /api/policy: SuperAdmin Right-Sized Allocation Formula Tuning
• /api/audit-logs: Comprehensive Immutable Activity Audit Trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="1095" y="210" width="530" height="110" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="rt3" value="• Multi-Channel Services: Semaphore SMS API, Gmail SMTP Nodemailer, Expo Push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l2" vertex="1"><mxGeometry x="1095" y="330" width="530" height="36" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="l3" value="TIER 3: DATA PERSISTENCE &amp; CLOUD INFRASTRUCTURE LAYER (MongoDB Atlas + External Gateways)" style="swimlane;startSize=35;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontSize=15;fontColor=#0F172A;rounded=1;arcSize=6;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="940" width="1680" height="380" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db_box" value="MongoDB Atlas Distributed Database (Mongoose ODM - 15 Data Models)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l3" vertex="1"><mxGeometry x="40" y="50" width="1100" height="300" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db1" value="1. User (Credentials, Roles, Scopes, Bcrypt Hashes)
2. Household (Roster, PriorityScore, QR, Status, Coordinates)
3. Distribution (Relief Release Logs, Headcount Snapshot)
4. DistributionEvent (Drive Batches, Venues, Targets, Active State)
5. AssistanceRequest (Citizen Special Needs, Fulfilled Status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="60" y="90" width="500" height="95" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db2" value="6. DamageReport (Severity, Geotag, Photos, Validation)
7. RecoveryStatus (5-Stage Linear Household State)
8. Incident (Field Disruptions, Evacuation Requests)
9. ReliefItemType (Base coverage, Top-up sizes, Stock limits)
10. WarehouseItem (Inventory Catalog, Stock Units, Reorder Min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="580" y="90" width="540" height="95" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db3" value="11. WarehouseLog (Stock Movement In/Out Logs, Notes)
12. Announcement (City/Barangay Notices, Mobile Deep-links)
13. PolicyConfig (Global Formula Ratios, Security Passcodes)
14. AuditLog (System-wide User Actions, IP &amp; Role Snapshots)
15. OtpToken (Auto-Purging TTL Index: 10 min / 600s expiration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="60" y="195" width="500" height="95" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db4" value="Data Integrity &amp; Anti-Duplicate Indexing:
• Unique Compound Index: { distributionEventId: 1, householdId: 1 }
• Strict Relational Populates: headOfHouseholdUserId, verifiedBy, releasedBy
• Memory Cache Fallback &amp; Automatic Reconnection Watchdog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="580" y="195" width="540" height="95" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="db5" value="Persistence Guarantee: 100% Cloud Clustered &amp; Replicated via MongoDB Atlas with Automatic Daily Snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="60" y="300" width="1060" height="32" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="ext_box" value="External Cloud Services &amp; Telecom Gateways" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#0F172A;fontSize=12;fontStyle=1;shadow=0;arcSize=8;" parent="l3" vertex="1"><mxGeometry x="1170" y="50" width="470" height="300" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="ext1" value="• Semaphore SMS Gateway:
  Real-time 6-digit OTP delivery to Philippine Telcos (Globe, Smart, DITO, TNT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="1185" y="90" width="440" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="ext2" value="• Google Gmail SMTP (Nodemailer):
  100% Free HTML OTP &amp; Verification Email Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="1185" y="150" width="440" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="ext3" value="• Expo Push Notification Gateway:
  Push Notifications to Field Staff and Resident Mobile Devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="1185" y="210" width="440" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="ext4" value="• Manila City GIS Data (TopoJSON):
  GeoJSON / TopoJSON shapefiles covering all 897 Barangays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="l3" vertex="1"><mxGeometry x="1185" y="270" width="440" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="e1" value="HTTPS / REST API Requests &amp; JWT Bearer Auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="w_box" target="gw_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e2" value="Real-Time Bi-Directional WebSocket Events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="w_box" target="eng_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e3" value="Mobile REST Endpoints &amp; Service Calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="m_box" target="rt_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e4" value="Mobile Socket.IO Listeners (Alerts/Queue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="m_box" target="eng_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e5" value="Mongoose ODM Queries &amp; Atomic Transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=1;fontSize=11;fontColor=#166534;" parent="1" source="gw_box" target="db_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e6" value="Stock Mutations &amp; Relational Populates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=1;fontSize=11;fontColor=#166534;" parent="1" source="rt_box" target="db_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e7" value="SMS / Email / Push Notifications" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=1;fontSize=11;fontColor=#166534;" parent="1" source="rt_box" target="ext_box" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
