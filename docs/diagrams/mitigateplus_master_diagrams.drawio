• Vulnerability Breakdown (Seniors, PWD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#1E293B;fontSize=11;fontStyle=1;align=center;shadow=0;arcSize=6;" parent="f2" vertex="1"><mxGeometry x="720" y="50" width="250" height="60" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="p2_5" value="5. Right-Sized Math Engine
BasePacks = max(1, floor(n / 5))
TopUpUnits = max(0, n - (Base * 5))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#1E293B;fontSize=11;fontStyle=1;align=center;shadow=0;arcSize=6;" parent="f2" vertex="1"><mxGeometry x="1010" y="50" width="230" height="60" as="geometry" ></mxGeometry></mxCell>
