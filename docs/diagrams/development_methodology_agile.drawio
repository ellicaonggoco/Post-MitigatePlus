      <mxCell id="es1" value="Sprint 2 Commitment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="s1" target="s2" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="es2" value="Sprint 3 Commitment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="s2" target="s3" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="es3" value="Sprint 4 Commitment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="s3" target="s4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="es4" value="System Hardening &amp; Release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1557B0;strokeWidth=2;fontSize=11;fontColor=#1E293B;" parent="1" source="s4" target="s5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
