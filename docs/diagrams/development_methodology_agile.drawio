<mxfile host="app.diagrams.net"><diagram id="Agile_Scrum_Methodology" name="Agile Scrum Methodology">
  <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="at1" value="MITIGATEPLUS: AGILE SCRUM DEVELOPMENT METHODOLOGY" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0B2E59;" parent="1" vertex="1"><mxGeometry x="350" y="30" width="1100" height="35" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="at2" value="Iterative, Sprint-Driven Software Engineering Lifecycle for Disaster Response &amp; Recovery Management" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" parent="1" vertex="1"><mxGeometry x="350" y="65" width="1100" height="25" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="rat_box" value="WHY AGILE SCRUM WAS CHOSEN FOR MITIGATEPLUS:
• Rapid Response to Dynamic Disaster Requirements: Enables fast adjustments to LGU relief distribution policies and Philippine disaster protocols (MDRRMO).
• Continuous Stakeholder Feedback: Bi-weekly demonstrations with Barangay Captains, Relief Volunteers, and Disaster Coordinators.
• Incremental Risk Reduction: High-risk components (Real-Time Anti-Duplicate QR Scanner, Smart Priority Math) were tested and validated in early sprints.
• 100% Quality &amp; Deployment Readiness: Continuous Integration, automated code audits, and sprint retrospectives ensure zero defect leakage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontStyle=1;align=left;spacingLeft=16;shadow=1;" parent="1" vertex="1"><mxGeometry x="80" y="110" width="1640" height="110" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0" value="SPRINT 0: INCEPTION &amp; ARCHITECTURE (Weeks 1-2)" style="swimlane;startSize=40;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="80" y="250" width="300" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_1" value="• Requirements Elicitation with Manila City LGU &amp; Disaster Councils" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="55" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_2" value="• 3-Tier Layered Architecture Definition (Express + React + Expo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="110" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_3" value="• MongoDB Schema Modeling (15 Collections &amp; Compound Indexes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="165" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_4" value="• Design System Tokens &amp; Wireframing (Manila Blue &amp; Neumorphic UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="220" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_5" value="• Git Repository Setup, CI/CD, and Development Environment Setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="275" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s0_del" value="DELIVERABLE:
System Architecture Blueprint, Database Schemas, Project Backlog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s0" vertex="1"><mxGeometry x="15" y="330" width="270" height="65" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1" value="SPRINT 1: CORE AUTH &amp; ROLES (Weeks 3-4)" style="swimlane;startSize=40;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="415" y="250" width="300" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_1" value="• Multi-Tier Role-Based Authentication (JWT &amp; Bcrypt Hashing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="55" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_2" value="• Semaphore SMS &amp; Gmail SMTP OTP Verification Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="110" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_3" value="• Web-Admin Portal Shell &amp; Dynamic Role-Based Navigation Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="165" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_4" value="• SuperAdmin Account Provisioning &amp; Security Enforcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="220" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_5" value="• Auto-Bootstrapping System for Default Executive &amp; Staff Accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="275" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s1_del" value="DELIVERABLE:
Secure Authentication Gateway, Provisioning Subsystem, Active RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s1" vertex="1"><mxGeometry x="15" y="330" width="270" height="65" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2" value="SPRINT 2: RESIDENT PORTAL &amp; AI INDEX (Weeks 5-6)" style="swimlane;startSize=40;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="750" y="250" width="300" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_1" value="• Mobile 2-Step Resident Registration &amp; Family Roster Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="55" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_2" value="• Smart Priority Index Algorithm (Damage + Vulnerability - Penalty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="110" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_3" value="• Barangay Verification Queue with Real-Time Address Overlap Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="165" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_4" value="• Singpass-Style Encrypted QR Relief Pass Generation with Export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="220" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_5" value="• Citizen Damage Reporting Module with Photo Evidence Upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="275" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s2_del" value="DELIVERABLE:
Mobile Resident App, Priority Scoring Engine, Digital QR Passes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s2" vertex="1"><mxGeometry x="15" y="330" width="270" height="65" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3" value="SPRINT 3: LGU OPS &amp; GIS HEATMAP (Weeks 7-8)" style="swimlane;startSize=40;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="1085" y="250" width="300" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_1" value="• Interactive Manila City GIS Heatmap (897 Barangays TopoJSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="55" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_2" value="• Central Warehouse Inventory System (Capacity Bars &amp; Reorder Min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="110" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_3" value="• Right-Sized Relief Allocation Engine (Headcount Multipliers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="165" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_4" value="• Distribution Events Manager (Heatmap Pre-fill &amp; Stock Dispatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="220" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_5" value="• Civic Announcements Engine with Mobile Deep-Link Action Triggers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="275" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s3_del" value="DELIVERABLE:
GIS Command Center, Warehouse Engine, Relief Allocation Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s3" vertex="1"><mxGeometry x="15" y="330" width="270" height="65" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4" value="SPRINT 4: QR SCANNER &amp; FRAUD ENGINE (Weeks 9-10)" style="swimlane;startSize=40;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="1420" y="250" width="300" height="420" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_1" value="• Field Staff QR Scanner Screen &amp; Instant Beneficiary Lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="55" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_2" value="• Real-Time Anti-Duplicate Claim Interceptor (Database Compound Lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="110" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_3" value="• Socket.IO Live Alert Streaming to Web Command Center (admin_room)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="165" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_4" value="• Special Relief Request Door-to-Door Assignment &amp; Mobile Fulfillment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="220" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_5" value="• 5-Stage Household Recovery Stepper (Waiting to Fully Recovered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="275" width="270" height="45" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s4_del" value="DELIVERABLE:
Field Staff QR Scanner App, Anti-Fraud Engine, Live Socket Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s4" vertex="1"><mxGeometry x="15" y="330" width="270" height="65" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5" value="SPRINT 5: PRODUCTION HARDENING, AUDIT &amp; DEPLOYMENT (Weeks 11-12)" style="swimlane;startSize=40;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;fontStyle=1;fontSize=14;fontColor=#0F172A;rounded=1;arcSize=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="80" y="710" width="1640" height="280" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_1" value="1. Automated Static Code Audits:
   Scanned 56 files across Web, Mobile &amp; Backend; eliminated all missing imports &amp; broken hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="40" y="55" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_2" value="2. End-to-End Integration Testing:
   Simulated full disaster cycles: Registration -&gt; Verification -&gt; Allocation -&gt; QR Scan -&gt; Recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="40" y="115" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_3" value="3. Production Database Migration:
   Configured MongoDB Atlas Cluster with automatic TTL indexing and daily snapshot backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="40" y="175" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_4" value="4. Immutable Audit Logs &amp; PDF Exporter:
   Comprehensive system audit logger with printable Mayor/LGU disaster summary reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="570" y="55" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_5" value="5. Security &amp; RBAC Boundary Validation:
   Verified exact permissions for SuperAdmin, Admin, Official, Field Staff, and Resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="570" y="115" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_6" value="6. Cross-Platform UI Polish &amp; Localization:
   Bilingual support (English / Tagalog), Light/Dark themes, responsive mobile viewports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="570" y="175" width="500" height="50" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="s5_7" value="FINAL PRODUCTION DELIVERABLE:
100% Deployment-Ready, Zero-Demo-Artifact MitigatePlus Post-Disaster Recovery Ecosystem
(Live Backend on Port 5000, Vite Web Admin on Port 3000, Expo Mobile App on Port 8081)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#334155;fontSize=11;align=left;spacingLeft=8;" parent="s5" vertex="1"><mxGeometry x="1100" y="55" width="500" height="170" as="geometry" ></mxGeometry></mxCell>
      <mxCell id="cer_box" value="RECURRING AGILE CEREMONIES THROUGHOUT ALL SPRINTS:
• Daily Standups (15 mins): Yesterday&apos;s progress, Today&apos;s goals, Blockers
• Sprint Planning (Day 1 of Sprint): User story estimation &amp; backlog commitment
• Sprint Review &amp; Demo (Final day): Live feature walkthrough with stakeholders
• Sprint Retrospective: Code quality reflection, technical debt remediation, and workflow optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=12;align=left;spacingLeft=16;" parent="1" vertex="1"><mxGeometry x="80" y="1020" width="1640" height="90" as="geometry" ></mxGeometry></mxCell>
